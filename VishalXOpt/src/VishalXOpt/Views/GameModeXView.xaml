<UserControl x:Class="VishalXOpt.Views.GameModeXView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VishalXOpt.Converters">
    <UserControl.Resources>
        <conv:BoolToStringConverter x:Key="BoolToString"/>
    </UserControl.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="&#x2190; Back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" Margin="0,0,12,0"/>
            <TextBlock Text="GameModeX" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" MaxWidth="520" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Session boost" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,16">
                    While on: keeps whichever window is in the foreground boosted to High priority (following you
                    if you alt-tab), drops Discord/Spotify/browsers/Teams/Slack/OneDrive to Below Normal if they're
                    running, and switches to the Ultimate Performance power plan. Turning it off restores everything.
                </TextBlock>

                <Button Content="{Binding IsActive, Converter={StaticResource BoolToString}, ConverterParameter='Disable Game Mode|Enable Game Mode'}"
                        Style="{StaticResource PrimaryButton}" Command="{Binding ToggleCommand}"
                        HorizontalAlignment="Left" MinWidth="180"/>

                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
