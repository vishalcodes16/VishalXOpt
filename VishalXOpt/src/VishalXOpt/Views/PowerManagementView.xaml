<UserControl x:Class="VishalXOpt.Views.PowerManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Power management" Style="{StaticResource TitleText}" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="{Binding ActiveScheme, StringFormat=Active plan: {0}}" Style="{StaticResource BodyText}" Margin="0,0,0,16"/>

        <CheckBox Grid.Row="2" Content="This is a laptop (protect battery-saving settings)" IsChecked="{Binding IsLaptop}" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="3">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Ultimate Performance plan" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Duplicates and activates Windows' hidden Ultimate Performance power scheme - removes most CPU park/ramp stalls." Style="{StaticResource BodyText}" Margin="0,4,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Enable" Style="{StaticResource PrimaryButton}" Command="{Binding EnableUltimatePerformanceCommand}" Margin="0,0,8,0"/>
                        <Button Content="Restore Balanced" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreBalancedCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="CPU minimum state" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Sets the CPU minimum state to 100% on AC power (desktop-only - skipped automatically if this is marked as a laptop)." Style="{StaticResource BodyText}" Margin="0,4,0,12"/>
                    <Button Content="Set to 100%" Style="{StaticResource SecondaryButton}" Command="{Binding MaxCpuStateCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="USB selective suspend" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Disables USB selective suspend for the active plan - stops mice/controllers momentarily waking up from a power-saving sleep." Style="{StaticResource BodyText}" Margin="0,4,0,12"/>
                    <Button Content="Disable" Style="{StaticResource SecondaryButton}" Command="{Binding DisableUsbSuspendCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,16,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
