<UserControl x:Class="VishalXOpt.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Greeting}" Style="{StaticResource TitleText}"/>
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- A small animated mark - the "3D animated" touch called for in the project spec,
                 kept deliberately simple (a looping rotation) so it's cheap and reliable. -->
            <Viewbox Grid.Column="1" Width="48" Height="48" RenderTransformOrigin="0.5,0.5">
                <Viewbox.RenderTransform>
                    <RotateTransform x:Name="LogoRotate"/>
                </Viewbox.RenderTransform>
                <Viewbox.Triggers>
                    <EventTrigger RoutedEvent="Viewbox.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="LogoRotate" Storyboard.TargetProperty="Angle"
                                                  From="0" To="360" Duration="0:0:6" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Viewbox.Triggers>
                <Path Data="M 12,2 L 22,8 L 22,16 L 12,22 L 2,16 L 2,8 Z" Fill="{StaticResource AccentGradientBrush}"/>
            </Viewbox>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Background="{StaticResource AccentGradientBrush}">
                <StackPanel>
                    <TextBlock Text="Vishal X Opt" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Free system, privacy and gaming-latency tuning - every tab unlocked, no Pro tier."
                               Foreground="White" Opacity="0.9" TextWrapping="Wrap" Margin="0,8,0,16"/>
                    <Button Content="Start optimization" Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartOptimizationCommand}" HorizontalAlignment="Left" Background="White" Foreground="#4C6FFF"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="96" Height="96" CornerRadius="48" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="4">
                        <TextBlock Text="{Binding OptimizationScore, StringFormat={}{0}%}" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Optimization" Style="{StaticResource BodyText}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding OptimizationLevel}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Tools" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8"/>
                    <TextBlock Text="GodMode, an internet latency/jitter test, and a CPU-vs-GPU bottleneck check."
                               Style="{StaticResource BodyText}" Margin="0,0,0,12"/>
                    <Button Content="Open Tools" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                            Command="{Binding OpenToolsCommand}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Tip" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Tip}" Style="{StaticResource BodyText}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
