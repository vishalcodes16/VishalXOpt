<UserControl x:Class="VishalXOpt.Views.GameReadyXView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VishalXOpt.Converters">
    <UserControl.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <conv:CheckStatusToBrushConverter x:Key="StatusToBrush"/>
        <conv:CheckStatusToGlyphConverter x:Key="StatusToGlyph"/>
    </UserControl.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="&#x2190; Back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" Margin="0,0,12,0"/>
            <TextBlock Text="GameReadyX" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Run checks" Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Checks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                        Background="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                        Margin="0,0,14,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToGlyph}}"
                                               Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource BodyText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
