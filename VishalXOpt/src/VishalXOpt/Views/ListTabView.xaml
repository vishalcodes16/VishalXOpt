<UserControl x:Class="VishalXOpt.Views.ListTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VishalXOpt.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid Margin="28" Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding TabTitle}" Style="{StaticResource TitleText}"/>
            <Button Grid.Column="1" Content="{Binding PrimaryActionLabel}" Style="{StaticResource SecondaryButton}"
                    Command="{Binding PrimaryActionCommand}" Margin="0,0,8,0"
                    Visibility="{Binding PrimaryActionCommand, Converter={StaticResource NullToVis}}"/>
            <Button Grid.Column="2" Content="{Binding SecondaryActionLabel}" Style="{StaticResource SecondaryButton}"
                    Command="{Binding SecondaryActionCommand}" Margin="0,0,8,0"
                    Visibility="{Binding SecondaryActionCommand, Converter={StaticResource NullToVis}}"/>
            <Button Grid.Column="3" Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"/>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}"
                                              VerticalAlignment="Center" Margin="0,0,12,0"
                                              Visibility="{Binding HasToggle, Converter={StaticResource BoolToVis}}"/>

                                <Button Grid.Column="2" Content="{Binding ExtraActionLabel}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ExtraCommand}" VerticalAlignment="Center"
                                        Visibility="{Binding ExtraCommand, Converter={StaticResource NullToVis}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,12,0,0"/>
    </Grid>
</UserControl>
