<UserControl x:Class="VishalXOpt.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" Style="{StaticResource TitleText}" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="{Binding AppVersion, StringFormat=Vishal X Opt version {0}}" Style="{StaticResource BodyText}" Margin="0,0,0,20"/>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Backups &amp; Undo" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,4"/>
                <TextBlock Text="Every Apply saves a snapshot of what it changed. Undo replays the most recent one." Style="{StaticResource BodyText}" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Undo last change" Style="{StaticResource PrimaryButton}" Command="{Binding UndoLastCommand}" Margin="0,0,8,0"/>
                    <Button Content="Refresh list" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding Snapshots}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TimestampUtc}" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
