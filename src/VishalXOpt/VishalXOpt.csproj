<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>VishalXOpt</AssemblyName>
    <RootNamespace>VishalXOpt</RootNamespace>
    <!-- Add ApplicationIcon>Assets\app.ico</ApplicationIcon> back once you drop a real .ico into Assets\ -->
    <Version>1.0.0</Version>
    <Product>Vishal X Opt</Product>
    <Company>Vishal X Opt</Company>
    <Description>Free, all-in-one Windows optimization &amp; tweaking suite.</Description>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- WMI (device / interrupt enumeration) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- Windows service control (SysMain, WSearch, DiagTrack, ...) -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <!-- CPU/GPU performance counters (Bottleneck tool) -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\tweaks.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
