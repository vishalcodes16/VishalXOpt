{
  "tweaks": [
    {
      "id": "basic.mouse_acceleration",
      "tab": "Basic",
      "name": "Mouse acceleration",
      "description": "Removes the OS pointer-acceleration curve for raw 1:1 aim.",
      "risk": "None",
      "kind": "Registry",
      "registryEntries": [
        {
          "hive": "CurrentUser",
          "path": "Control Panel\\Mouse",
          "valueName": "MouseSpeed",
          "valueKind": "String",
          "onValue": "0",
          "offValue": "1"
        },
        {
          "hive": "CurrentUser",
          "path": "Control Panel\\Mouse",
          "valueName": "MouseThreshold1",
          "valueKind": "String",
          "onValue": "0",
          "offValue": "6"
        },
        {
          "hive": "CurrentUser",
          "path": "Control Panel\\Mouse",
          "valueName": "MouseThreshold2",
          "valueKind": "String",
          "onValue": "0",
          "offValue": "10"
        }
      ],
      "defaultOn": false,
      "optimalOn": true,
      "maximumOn": true
    },
    {
      "id": "basic.game_dvr",
