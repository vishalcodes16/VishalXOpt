<UserControl x:Class="VishalXOpt.Views.StoreXView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VishalXOpt.Converters">
    <UserControl.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
    </UserControl.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="&#x2190; Back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" Margin="0,0,12,0"/>
            <TextBlock Text="StoreX" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Apps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding App.Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding App.Category}" Style="{StaticResource BodyText}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="3" Content="Install selected" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                Command="{Binding InstallSelectedCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Margin="0,16,0,0"/>
    </Grid>
</UserControl>
