<UserControl x:Class="VishalXOpt.Views.DevicesInterruptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VishalXOpt.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="28" Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Devices &amp; Interrupts" Style="{StaticResource TitleText}"/>
            <Button Grid.Column="1" Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"/>
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,0,0,16"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Devices + MSI Mode -->
            <ScrollViewer Grid.Column="0" Margin="0,0,16,0">
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Cursor="Hand"
                                    MouseLeftButtonUp="OnDeviceRowClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0"
                                                Visibility="{Binding MsiSupported, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="MSI Mode" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsMsiEnabled}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                Visibility="{Binding ShowUnnecessaryToggle, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Enabled" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsDeviceEnabled}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Interrupt affinity for the selected device -->
            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Interrupt affinity" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Selected: " Style="{StaticResource BodyText}"/>
                        <TextBlock Text="{Binding SelectedDevice.Name, FallbackValue='(click a device on the left)'}"
                                   Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding AffinityThreads}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,0,14,10"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,16">
                        <Button Content="Pin selected threads" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyAffinityCommand}" Margin="0,0,8,0"/>
                        <Button Content="Clear" Style="{StaticResource SecondaryButton}" Command="{Binding ClearAffinityCommand}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Lock Interrupt Routing" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LockInterruptRouting}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
