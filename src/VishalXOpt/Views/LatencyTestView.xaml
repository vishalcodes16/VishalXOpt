<UserControl x:Class="VishalXOpt.Views.LatencyTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VishalXOpt.Converters">
    <UserControl.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
    </UserControl.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="&#x2190; Back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" Margin="0,0,12,0"/>
            <TextBlock Text="PC Latency Test" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" MaxWidth="560" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Scheduler jitter test" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding ResultText}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <Button Content="Run (3s)" Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
