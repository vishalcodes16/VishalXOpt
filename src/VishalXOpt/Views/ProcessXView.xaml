<UserControl x:Class="VishalXOpt.Views.ProcessXView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VishalXOpt.Converters">
    <UserControl.Resources>
        <conv:BoolToStringConverter x:Key="BoolToString"/>
    </UserControl.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="&#x2190; Back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" Margin="0,0,12,0"/>
            <TextBlock Text="ProcessX" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Process name (no .exe), e.g. Discord" Style="{StaticResource BodyText}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" Margin="0,0,10,0" Background="{StaticResource PanelBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush2}"
                             VerticalContentAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding NewPriority}" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="Add rule" Style="{StaticResource SecondaryButton}" Command="{Binding AddRuleCommand}"/>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="{Binding IsRunning, Converter={StaticResource BoolToString}, ConverterParameter='Stop automation|Start automation'}"
                    Style="{StaticResource PrimaryButton}" Command="{Binding ToggleAutomationCommand}" Margin="0,0,8,0"/>
            <Button Content="Apply once" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyOnceCommand}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding Rules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ProcessName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding PriorityText}" Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <ToggleButton Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}" Margin="0,0,12,0"/>
                                <Button Grid.Column="3" Content="Remove" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveCommand}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,12,0,0"/>
    </Grid>
</UserControl>
