<Window x:Class="VishalXOpt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VishalXOpt.ViewModels"
        xmlns:conv="clr-namespace:VishalXOpt.Converters"
        Title="Vishal X Opt" Height="780" Width="1280" MinHeight="560" MinWidth="900"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Window.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVis"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Icon rail -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ToggleButton Style="{StaticResource NavRailButton}" IsChecked="{Binding IsHomeSelected, Mode=OneWay}"
                              Command="{Binding GoHomeCommand}" ToolTip="Home">
                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"/>
                </ToggleButton>
                <ToggleButton Style="{StaticResource NavRailButton}" IsChecked="{Binding IsOptimizationSelected, Mode=OneWay}"
                              Command="{Binding GoOptimizationCommand}" ToolTip="Optimization">
                    <TextBlock Text="&#xE9A1;" FontFamily="Segoe MDL2 Assets"/>
                </ToggleButton>
                <ToggleButton Style="{StaticResource NavRailButton}" IsChecked="{Binding IsToolsSelected, Mode=OneWay}"
                              Command="{Binding GoToolsCommand}" ToolTip="Tools">
                    <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets"/>
                </ToggleButton>
                <ToggleButton Style="{StaticResource NavRailButton}" IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                              Command="{Binding GoSettingsCommand}" ToolTip="Settings">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"/>
                </ToggleButton>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding Home}"
                             Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVis}, ConverterParameter=Home}"/>
            <ContentControl Content="{Binding Optimization}"
                             Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVis}, ConverterParameter=Optimization}"/>
            <ContentControl Content="{Binding Tools}"
                             Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVis}, ConverterParameter=Tools}"/>
            <ContentControl Content="{Binding Settings}"
                             Visibility="{Binding CurrentSection, Converter={StaticResource EnumToVis}, ConverterParameter=Settings}"/>
        </Grid>
    </Grid>
</Window>
